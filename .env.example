# Copy to .env and adjust. docker-compose reads these automatically.

# --- Orchestrator ---
DATABASE_URL=postgres://opamp:opamp@postgres:5432/opamp?sslmode=disable
OPAMP_LISTEN_ENDPOINT=:4320
OPAMP_LISTEN_PATH=/v1/opamp
ADMIN_LISTEN_ENDPOINT=:8080
PUBLIC_BASE_URL=http://orchestrator:8080
DEFAULT_GROUP=default
LOG_LEVEL=info

# Optional auth (leave empty to disable):
OPAMP_AUTH_TOKEN=
ADMIN_AUTH_TOKEN=

# --- OpsRamp connector (optional) ---
# API host for your pod, e.g. https://pod7.api.opsramp.com (this box is on pod7).
OPSRAMP_API_URL=
# Tenant/client id used in /api/v2/tenants/{tenantId}/...
OPSRAMP_TENANT_ID=
# OAuth2 client credentials from an OpsRamp Integration (key/secret).
OPSRAMP_CLIENT_KEY=
OPSRAMP_CLIENT_SECRET=
# How often to sync the agent inventory.
OPSRAMP_POLL_INTERVAL=60s

# --- Demo agent ---
OPAMP_SERVER_URL=ws://orchestrator:4320/v1/opamp
AGENT_SERVICE_NAME=demo-monitoring-agent
AGENT_SERVICE_VERSION=1.0.0
AGENT_LABELS=env=prod,region=us-east-1
AGENT_STATE_DIR=/data
